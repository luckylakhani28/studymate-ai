{
  "name": "@studymate/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "dev:worker": "node --watch --max-old-space-size=1024 --env-file-if-exists=.env src/worker.js",
    "worker": "node --max-old-space-size=1024 --env-file-if-exists=.env src/worker.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:sync-indexes": "node --env-file-if-exists=.env src/scripts/syncIndexes.js",
    "seed:demo": "node --env-file-if-exists=.env src/scripts/seedDemo.js",
    "prefetch-models": "node src/scripts/prefetchModels.js",
    "inspect-pdf": "node --env-file-if-exists=.env src/scripts/inspectPdf.js",
    "eval:retrieval": "node --env-file-if-exists=.env src/scripts/evalRetrieval.js",
    "eval:qa": "node --env-file-if-exists=.env src/scripts/evalQa.js",
    "eval:injection": "node --env-file-if-exists=.env src/scripts/evalInjection.js",
    "ai:smoke": "node --env-file-if-exists=.env src/scripts/aiSmoke.js",
    "usage:report": "node --env-file-if-exists=.env src/scripts/usageReport.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@huggingface/transformers": "^3.6.0",
    "@napi-rs/canvas": "^0.1.74",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.0",
    "multer": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.3.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "tesseract.js": "^6.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.0",
    "mongodb-memory-server": "^10.1.4",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
