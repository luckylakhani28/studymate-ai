NODE_ENV=development
PORT=5050
LOG_LEVEL=info
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string (include a database name, e.g. .../studymate?retryWrites=true)
MONGODB_URI=

# Auth: generate with node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
# Set only while rotating secrets: the old secret keeps existing tokens valid until they expire
# JWT_ACCESS_SECRET_PREVIOUS=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
COOKIE_SAMESITE=strict

# Uploads and storage (STORAGE_DRIVER=gridfs stores PDFs in MongoDB, e.g. on hosts with ephemeral disks)
STORAGE_DRIVER=local
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25
MAX_DOCUMENTS_PER_USER=100

# Background worker
WORKER_POLL_MS=2000
JOB_LOCK_TTL_MS=60000
JOB_TIMEOUT_MS=600000
JOB_MAX_ATTEMPTS=3
MAX_PDF_PAGES=300
# true = run the job worker inside the API process (single-service hosting)
RUN_WORKER_IN_API=false

# OCR
OCR_LANGS=eng
OCR_DPI=200
OCR_MAX_PAGES=100
OCR_CACHE_DIR=./.ocr-cache

# Embeddings and retrieval
EMBEDDING_PROVIDER=local
EMBEDDING_CACHE_DIR=./.model-cache
VECTOR_SEARCH_MODE=atlas
VECTOR_INDEX_NAME=chunk_vector_index

# LLM
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL_FAST=claude-haiku-4-5-20251001
AI_MODEL_SMART=claude-sonnet-5-5
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
# USD per million tokens. Verify against the official pricing page.
AI_PRICE_FAST_INPUT=1
AI_PRICE_FAST_OUTPUT=5
AI_PRICE_SMART_INPUT=3
AI_PRICE_SMART_OUTPUT=15

# Q&A and study tools (tune QA_MIN_SCORE with npm run eval:retrieval)
QA_MIN_SCORE=0.75
QA_CONTEXT_TOKENS=3000
DIGEST_GROUP_TOKENS=3000

# Production single-origin hosting: the API serves the built client from this folder
# SERVE_CLIENT_DIR=../client/dist
